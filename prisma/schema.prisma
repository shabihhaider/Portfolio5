generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  content         String
  excerpt         String?
  coverImage      String?
  author          String    @default("Shabih Haider")
  status          String    @default("draft")
  publishedAt     DateTime?
  metaDescription String?
  metaKeywords    String[]
  ogImage         String?
  tags            String[]
  category        String    @default("Tech")
  views           Int       @default(0)
  likes           Int       @default(0)
  readingTime     String?
  ctaClicks       Int       @default(0)
  generatedBy     String?
  humanEdited     Boolean   @default(false)
  qualityScore    Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  scheduledFor    DateTime?

  @@index([status])
  @@index([publishedAt])
  @@index([scheduledFor])
  @@index([slug])
  @@map("posts")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("blog_footer")
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Analytics {
  id        String   @id @default(cuid())
  type      String
  path      String?
  postId    String?
  userAgent String?
  ipHash    String?
  timestamp DateTime @default(now())

  @@map("analytics")
}

model SiteSettings {
  id                String   @id @default(cuid())
  autoPublish       Boolean  @default(false)
  postingSchedule   String   @default("weekly")
  contentTopics     String[]
  aiTone            String   @default("friendly and practical")
  minWordCount      Int      @default(500)
  maxWordCount      Int      @default(700)
  updatedAt         DateTime @updatedAt
  ctaLink           String   @default("https://shabih.tech")
  ctaText           String   @default("")
  includeSetupSteps Boolean  @default(true)
  internalLink      String   @default("https://shabih.tech")
  sponsorEnabled    Boolean  @default(false)
  sponsorLink       String   @default("")
  sponsorText       String   @default("")
  targetAudience    String   @default("mixed")

  @@map("site_settings")
}
